+
+
+def test_feature_names_independent_of_catalog_dict_order():
+    """A config re-serialised with sorted keys must not reorder the Contract C5 columns."""
+    import copy
+
+    from eegpipe.config import load_config
+    from eegpipe.features.extract import feature_names
+
+    cfg = load_config()
+    shuffled = copy.deepcopy(cfg)
+    shuffled["features"]["catalog"] = dict(reversed(list(cfg["features"]["catalog"].items())))
+    assert feature_names(shuffled) == feature_names(cfg)
