# --- Project data and generated artifacts (configs/config.yaml -> paths.*) ---
# Everything under data/ is generated or downloaded, never committed. results/predictions
# and results/logs are also generated (git-ignored); results/tables and results/figures
# ARE committed (Member C's Step 12 deliverables), so they must NOT be ignored here.
#
# Pattern note: a plain "data/" or "results/" line would make .gitkeep un-ignoring
# impossible below, and would also block results/tables and results/figures. So:
# ignore everything under data/, then re-include directories and .gitkeep placeholders.
data/**
!data/**/
!data/**/.gitkeep
results/predictions/**
!results/predictions/.gitkeep
results/logs/**
!results/logs/.gitkeep

# Safety net: raw and cached data must never be committed, wherever it ends up
*.edf
*.npy
*.npz
*.parquet
*.h5

# --- Model / evaluation artifacts (Member C, Section evaluation.*) ---
*.joblib
*.pkl
*.pickle

# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/

# numba's on-disk JIT cache (nonlinear.py: @njit(cache=True)) lands as
# .nbi/.nbc files inside __pycache__, already covered above, but numba can
# also use a top-level cache dir depending on version/config:
.numba_cache/
caches/
checkpoints/

# --- Test / lint / type-check caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Jupyter (notebooks/A_*, B_*, C_*) ---
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Secrets / local overrides ---
.env
*.local.yaml
